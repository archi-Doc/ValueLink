<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <IsPackable>false</IsPackable>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <TrimmerRootAssembly Include="ValueLink" />
    <ProjectReference Include="../NativeAotModels/NativeAotModels.csproj" />
    <ProjectReference Include="../ValueLink/ValueLink.csproj" />
    <ProjectReference Include="../ValueLinkGenerator/ValueLinkGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
